{
  "Middleware": {
    "LisUrl": "https://localhost/api/analyzer/astm",
    "WatchFolder": "./TestingResources",
    "OutboxDbPath": "./data/outbox.db",
    "DeliveryBatchSize": 50,
    "RetryScheduleSeconds": [ 10, 30, 120, 300 ],
    "LisSecurity": {
      "RequireTls": true,
      "BearerToken": "",
      "BasicUsername": "admin",
      "BasicPassword": "adminADMIN!",
      "AllowInvalidServerCertificate": true
    },
    "LisDelivery": {
      "PayloadMode": "RawMessage",
      "ContentType": "text/plain; charset=utf-8",
      "SendOneRecordPerIncomingMessage": true
    },
    "Resilience": {
      "HttpTimeoutSeconds": 10,
      "CircuitBreakerFailureThreshold": 5,
      "CircuitBreakerBreakSeconds": 30
    },
    "Tcp": {
      "Enabled": true,
      "Port": 5001
    },
    "Serial": {
      "Enabled": false,
      "PortName": "COM1",
      "BaudRate": 9600
    },
    "Analyzers": [
      {
        "Name": "hl7-mllp-default",
        "SourceMachine": "Analyzer-HL7",
        "Transport": "Tcp",
        "Protocol": "Hl7Mllp",
        "TcpPort": 5001,
        "EncodingName": "utf-8"
      },
      {
        "Name": "astm-tcp-default",
        "SourceMachine": "Analyzer-ASTM",
        "Transport": "Tcp",
        "Protocol": "Astm",
        "TcpPort": 5002,
        "EncodingName": "ascii"
      },
      {
        "Name": "file-drop-default",
        "SourceMachine": "Analyzer-File",
        "Transport": "File",
        "Protocol": "Raw",
        "WatchFolder": "./TestingResources"
      }
    ]
  }
}
