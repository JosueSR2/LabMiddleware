{
  "Middleware": {
    "LisUrl": "https://localhost:8443/OpenELIS-Global/analyzer/astm",

    "WatchFolder": "./TestingResources",
    "OutboxDbPath": "./data/outbox.db",

    "DeliveryBatchSize": 50,

    "RetryScheduleSeconds": [10, 30, 120, 300],

    "LisSecurity": {
      "RequireTls": true,
      "AllowInvalidServerCertificate": false, 
      "ClientCertificatePath": "./Certificates/middleware-cert.pem",
      "ClientKeyPath": "./Certificates/middleware-key.pem",
      "TrustStorePath": "./Certificates/oe-truststore.p12",
      "TrustStorePassword": "changeit"
    },

    "LisDelivery": {
      "PayloadMode": "RawMessage",
      "ContentType": "text/plain",
      "Accept": "text/plain",
      "SendOneRecordPerIncomingMessage": true
    },

    "Resilience": {
      "HttpTimeoutSeconds": 30,
      "CircuitBreakerFailureThreshold": 5,
      "CircuitBreakerBreakSeconds": 30
    },

    "Tcp": {
      "Enabled": true,
      "Port": 5001
    },

    "Serial": {
      "Enabled": false,
      "PortName": "COM1",
      "BaudRate": 9600
    },

    "Analyzers": [
      {
        "Name": "hl7-mllp-default",
        "SourceMachine": "Analyzer-ASTM",
        "Transport": "Tcp",
        "Protocol": "Hl7Mllp",
        "TcpPort": 5001,
        "EncodingName": "utf-8",
        "LisAnalyzerName": "HL7_DEFAULT"
      },
      {
        "Name": "astm-tcp-default",
        "SourceMachine": "Analyzer-ASTM",
        "Transport": "Tcp",
        "Protocol": "Astm",
        "TcpPort": 5002,
        "EncodingName": "ascii",
        "LisAnalyzerName": "ASTM_DEFAULT"
      },
      {
        "Name": "file-drop-default",
        "SourceMachine": "Analyzer-ASTM",
        "Transport": "File",
        "Protocol": "Raw",
        "WatchFolder": "./TestingResources",
        "LisAnalyzerName": "FILE_IMPORT"
      }
    ]
  }
}